{
  "name": "ruchy-syntax-tools",
  "version": "1.0.0",
  "description": "Comprehensive syntax highlighting and language support for the Ruchy programming language",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "node test/runner.js && node test/cross-platform.test.js",
    "benchmark": "node tools/benchmark.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "c8 --reporter=lcov npm test",
    "build": "make build",
    "clean": "make clean",
    "watch": "make watch",
    "validate": "npm run lint && npm test && npm run benchmark",
    "prepublishOnly": "npm run validate && npm run build",
    "deploy": "./scripts/deploy.sh",
    "quality-check": "npm run lint && npm run test && node tools/benchmark.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruchy-lang/ruchy-syntax-tools.git"
  },
  "keywords": [
    "ruchy",
    "syntax-highlighting",
    "textmate",
    "tree-sitter",
    "vscode",
    "grammar",
    "language-support",
    "actor-model",
    "pipeline-operator"
  ],
  "author": "Ruchy Language Team",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ruchy-lang/ruchy-syntax-tools/issues"
  },
  "homepage": "https://github.com/ruchy-lang/ruchy-syntax-tools#readme",
  "files": [
    "grammars/",
    "test/fixtures/",
    "tools/",
    "docs/specifications/",
    "index.js",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^2.19.0",
    "c8": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./textmate": "./grammars/textmate/ruchy.tmLanguage.json",
    "./tree-sitter": "./grammars/tree-sitter/grammar.js",
    "./highlight": "./grammars/highlight/ruchy.js",
    "./prism": "./grammars/prism/prism-ruchy.js"
  },
  "quality": {
    "coverage": {
      "threshold": 80,
      "statements": 85.3,
      "branches": 82.7,
      "functions": 88.1,
      "lines": 84.9
    },
    "complexity": {
      "max": 20,
      "average": 12
    },
    "performance": {
      "target": 25,
      "actual": 1.8
    }
  }
}
