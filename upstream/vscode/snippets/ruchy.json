{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:function_name}(${2:params}) -> ${3:ReturnType} {",
      "\t$0",
      "}"
    ],
    "description": "Function definition"
  },
  "Async Function": {
    "prefix": "async fn",
    "body": [
      "async fn ${1:function_name}(${2:params}) -> ${3:Result<T, E>} {",
      "\t$0",
      "}"
    ],
    "description": "Async function definition"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:StructName} {",
      "\t${2:field}: ${3:Type},",
      "\t$0",
      "}"
    ],
    "description": "Struct definition"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "\t${2:Variant1},",
      "\t${3:Variant2}(${4:Type}),",
      "\t${5:Variant3} { ${6:field}: ${7:Type} },",
      "\t$0",
      "}"
    ],
    "description": "Enum definition"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\tfn ${2:method_name}(&self) -> ${3:ReturnType} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implementation block"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:TraitName} {",
      "\tfn ${2:method_name}(&self) -> ${3:ReturnType};",
      "\t$0",
      "}"
    ],
    "description": "Trait definition"
  },
  "Actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:ActorName} {",
      "\t${2:state}: ${3:StateType},",
      "\t",
      "\tfn handle(msg: ${4:MessageType}) {",
      "\t\tmatch msg {",
      "\t\t\t${5:Pattern} => {",
      "\t\t\t\t$0",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Actor definition with message handler"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:expression} {",
      "\t${2:Pattern1} => ${3:result1},",
      "\t${4:Pattern2} => ${5:result2},",
      "\t_ => ${6:default},",
      "}"
    ],
    "description": "Match expression"
  },
  "Pipeline": {
    "prefix": ">>",
    "body": [
      "${1:data} >> ${2:transform1} >> ${3:transform2} >> ${4:result}"
    ],
    "description": "Pipeline operator chain"
  },
  "Actor Send": {
    "prefix": "<-",
    "body": [
      "${1:actor} <- ${2:message}"
    ],
    "description": "Send message to actor"
  },
  "Actor Ask": {
    "prefix": "<?",
    "body": [
      "let ${1:response} = ${2:actor} <? ${3:request}"
    ],
    "description": "Ask actor for response"
  },
  "Result Ok": {
    "prefix": "ok",
    "body": [
      "Ok(${1:value})"
    ],
    "description": "Result Ok variant"
  },
  "Result Err": {
    "prefix": "err",
    "body": [
      "Err(${1:error})"
    ],
    "description": "Result Err variant"
  },
  "Option Some": {
    "prefix": "some",
    "body": [
      "Some(${1:value})"
    ],
    "description": "Option Some variant"
  },
  "Option None": {
    "prefix": "none",
    "body": [
      "None"
    ],
    "description": "Option None variant"
  },
  "Let Binding": {
    "prefix": "let",
    "body": [
      "let ${1:mut }${2:variable} = ${3:value};"
    ],
    "description": "Variable binding"
  },
  "Closure": {
    "prefix": "||",
    "body": [
      "|${1:params}| ${2:expression}"
    ],
    "description": "Closure expression"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterator} {",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "If Expression": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2:// then}",
      "} else {",
      "\t${3:// else}",
      "}"
    ],
    "description": "If-else expression"
  },
  "If Let": {
    "prefix": "if let",
    "body": [
      "if let ${1:Pattern} = ${2:expression} {",
      "\t$0",
      "}"
    ],
    "description": "If-let pattern matching"
  },
  "Test Function": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:test_name}() {",
      "\t// Arrange",
      "\t${2:let value = 42;}",
      "\t",
      "\t// Act",
      "\t${3:let result = function(value);}",
      "\t",
      "\t// Assert",
      "\t${4:assert_eq!(result, expected);}",
      "}"
    ],
    "description": "Test function with AAA pattern"
  },
  "Todo Comment": {
    "prefix": "todo",
    "body": [
      "// TODO: ${1:description}"
    ],
    "description": "TODO comment"
  },
  "Doc Comment": {
    "prefix": "///",
    "body": [
      "/// ${1:Summary}",
      "///",
      "/// # Examples",
      "///",
      "/// ```",
      "/// ${2:example}",
      "/// ```"
    ],
    "description": "Documentation comment"
  },
  "Spawn Actor": {
    "prefix": "spawn",
    "body": [
      "let ${1:handle} = spawn ${2:ActorName} {",
      "\t${3:field}: ${4:value},",
      "};"
    ],
    "description": "Spawn a new actor"
  },
  "Generic Function": {
    "prefix": "fn generic",
    "body": [
      "fn ${1:function_name}<${2:T}>($3) -> ${4:T}",
      "where",
      "\t${2:T}: ${5:Trait},",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Generic function with where clause"
  },
  "Use Statement": {
    "prefix": "use",
    "body": [
      "use ${1:std}::${2:collections}::${3:HashMap};"
    ],
    "description": "Use statement"
  },
  "Module": {
    "prefix": "mod",
    "body": [
      "mod ${1:module_name} {",
      "\t$0",
      "}"
    ],
    "description": "Module definition"
  }
}