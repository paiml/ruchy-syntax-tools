// String and numeric literal test cases
// Tests comprehensive parsing of all supported formats

fn test_strings() {
    // Basic string literals
    let simple_double = "Hello, World!"
    let simple_single = 'Hello'
    let empty_string = ""
    let empty_char = ''
    
    // String with escape sequences
    let escaped = "Line 1\nLine 2\tTabbed\"Quoted\\"
    let hex_escapes = "\x41\x42\x43"  // ABC
    let unicode_escapes = "\u{1F600}\u{41}"  // 😀A
    
    // Raw strings (no escape processing)
    let raw_string = r"Raw string with \n no escapes"
    let raw_path = r"C:\Users\name\file.txt"
    
    // String interpolation (planned feature)  
    let name = "World"
    let interpolated = "Hello, ${name}!"
    let complex_interpolation = "Result: ${calculate(x, y)}"
    
    // Invalid strings (should be marked as errors)
    let invalid_escape = "Invalid \k escape"
    let invalid_hex = "Invalid \x5G hex"
    let invalid_unicode = "Invalid \u{GGGG} unicode"
    
    // Multiline strings (should highlight properly)
    let multiline = "This is a
    multiline string"
}

fn test_numbers() {
    // Integer literals
    let decimal_int = 42
    let large_decimal = 1_000_000
    let zero = 0
    
    // Hexadecimal integers
    let hex_lower = 0xff
    let hex_upper = 0xFF
    let hex_mixed = 0xDead_Beef
    let hex_with_separators = 0x1234_5678
    
    // Binary integers
    let binary = 0b1010_1010
    let binary_simple = 0b1101
    
    // Octal integers  
    let octal = 0o755
    let octal_with_separators = 0o123_456
    
    // Float literals
    let simple_float = 3.14
    let scientific = 1.23e-4
    let scientific_positive = 2.5E+10
    let no_leading = .5
    let no_trailing = 5.
    
    // Float with type suffixes
    let float32 = 3.14f
    let float64 = 2.718F
    
    // Integer type suffixes
    let unsigned_8 = 255u8
    let signed_16 = -32768i16
    let unsigned_32 = 4_294_967_295u32
    let signed_64 = 9_223_372_036_854_775_807i64
    let unsigned_128 = 340_282_366_920_938_463_463_374_607_431_768_211_455u128
    
    // Invalid numbers (should be marked as errors)
    let invalid_hex = 0x  // Missing digits
    let invalid_binary = 0b  // Missing digits  
    let invalid_octal = 0o  // Missing digits
}

fn test_edge_cases() {
    // Numbers in different contexts
    let array_with_numbers = [1, 2, 3, 0xFF, 0b1010]
    let calculation = 42 + 3.14 * 0x10
    
    // Strings in different contexts
    let string_array = ["hello", 'world', r"raw"]
    let concatenation = "Part 1" + " Part 2"
    
    // Mixed literals
    let tuple = (42, "string", 3.14, true)
    let struct_init = Point { x: 1.0, y: 2.0, name: "origin" }
    
    // Function calls with literals
    process_data(0xFF, "input.txt", 3.14159)
    
    // Pattern matching with literals
    match value {
        0 => "zero"
        1..=10 => "small"
        42 => "answer" 
        0xFF => "max byte"
        _ => "other"
    }
}