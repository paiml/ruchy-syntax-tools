    fn new(name: str, email: str, age: int) -> User {
        // NOTE: This is a simple constructor
        User { name, email, age }
    }
    
    /* HACK: Temporary workaround for database issue */
    fn save(&self) -> Result<()> {
        // BUG: This doesn't handle concurrent access
        database::save_user(self)
    }
}

